---
import '@fontsource-variable/fraunces/soft.css';
import '@fontsource-variable/source-sans-3';
import '../styles/global.css';

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import MobileBar from '../components/MobileBar.astro';
import Seo, { type SeoProps } from '../components/Seo.astro';

type Props = SeoProps;

const seo = Astro.props;
---

<!doctype html>
<html lang="ro" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#faf7f2" />
    <Seo {...seo} />
  </head>
  <body>
    <a class="skip-link" href="#continut">Sari la conținut</a>
    <Header />
    <main id="continut">
      <slot />
    </main>
    <Footer />
    <MobileBar />

    <script>
      // Elementele marcate cu data-reveal apar lin la scroll.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
      );
      items.forEach((item) => observer.observe(item));
    </script>
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }
</style>
