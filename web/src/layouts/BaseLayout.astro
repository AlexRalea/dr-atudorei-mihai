---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/source-sans-3';
import '../styles/global.css';

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import MobileBar from '../components/MobileBar.astro';
import Seo, { type SeoProps } from '../components/Seo.astro';

type Props = SeoProps;

const seo = Astro.props;
---

<!doctype html>
<html lang="ro" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#faf7f2" />
    <Seo {...seo} />
  </head>
  <body>
    <a class="skip-link" href="#continut">Sari la conținut</a>
    <Header />
    <main id="continut">
      <slot />
    </main>
    <Footer />
    <MobileBar />

    <script>
      const root = document.documentElement;

      // Elementele marcate cu data-reveal apar lin la scroll.
      const revealObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -32px 0px', threshold: 0.08 },
      );
      document.querySelectorAll('[data-reveal]').forEach((item) => revealObserver.observe(item));

      // Liniile desenate de mână se trasează o singură dată, când secțiunea intră în ecran.
      const inkObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.setAttribute('data-lines-revealed', '');
            inkObserver.unobserve(entry.target);
          }
        },
        { threshold: 0.08 },
      );
      document.querySelectorAll('[data-ink]').forEach((item) => inkObserver.observe(item));

      // Starea de scroll: header-ul se micșorează, iar bara de progres arată cât s-a citit.
      let frame = 0;
      const updateScroll = () => {
        frame = 0;
        const available = root.scrollHeight - window.innerHeight;
        root.style.setProperty('--page-progress', String(available > 0 ? window.scrollY / available : 0));
        root.toggleAttribute('data-scrolled', window.scrollY > 40);
      };
      const onScroll = () => {
        if (!frame) frame = requestAnimationFrame(updateScroll);
      };
      updateScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
    </script>
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }
</style>
