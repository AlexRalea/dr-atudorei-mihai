---
import Callout from '../../components/Callout.astro';
import ContactDetails from '../../components/ContactDetails.astro';
import ContactForm from '../../components/ContactForm.astro';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getConditions, getDoctor, getSettings } from '../../lib/content';
import { routes } from '../../lib/routes';
import { breadcrumbSchema, physicianSchema } from '../../lib/schema';

const [settings, doctor, conditions] = await Promise.all([getSettings(), getDoctor(), getConditions()]);
const breadcrumbs = [
  { name: 'Acasă', href: routes.home },
  { name: 'Contact', href: routes.contact },
];
const site = Astro.site!;
---

<BaseLayout
  title="Contact și programări"
  description={`Programați o consultație de chirurgia mâinii cu ${doctor.name}. Telefon, adresă, program și formular de programare.`}
  jsonLd={[
    physicianSchema(
      site,
      settings,
      doctor,
      conditions.map((condition) => condition.title),
    ),
    breadcrumbSchema(site, breadcrumbs),
  ]}
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Contact"
    title="Programați o consultație"
    intro="Completați formularul și vă sunăm pentru a stabili ziua și ora. Dacă preferați, ne puteți suna direct."
  />

  <section class="section">
    <div class="container contact-grid">
      <div class="form-card" id="programare">
        <h2>Cerere de programare</h2>
        <p class="muted">Câmpurile marcate fără „opțional” sunt necesare ca să vă putem contacta.</p>
        <ContactForm />
      </div>

      <aside class="contact-aside">
        <ContactDetails />
        <Callout tone="warning" title="Urgențe">
          Pentru accidentări recente cu sângerare, deformare sau amorțeală, mergeți la cea mai apropiată unitate de
          primiri urgențe sau sunați la 112.
        </Callout>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(2rem, 1rem + 3vw, 4rem);
    align-items: start;
  }

  .form-card {
    padding: clamp(1.25rem, 1rem + 1.5vw, 2.25rem);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow);
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  .form-card h2 {
    font-size: var(--text-xl);
  }

  .form-card > .muted {
    margin: 0.35rem 0 1.5rem;
    font-size: 1rem;
  }

  .contact-aside {
    display: grid;
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
