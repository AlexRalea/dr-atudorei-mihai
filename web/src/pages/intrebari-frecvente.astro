---
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/FaqList.astro';
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFaqs } from '../lib/content';
import { faqCategoryLabels } from '../lib/labels';
import { routes } from '../lib/routes';
import { breadcrumbSchema, faqSchema } from '../lib/schema';
import type { FaqCategory } from '../lib/types';

const faqs = await getFaqs();
const categories = (Object.keys(faqCategoryLabels) as FaqCategory[])
  .map((category) => ({
    category,
    label: faqCategoryLabels[category],
    items: faqs.filter((faq) => faq.category === category),
  }))
  .filter((group) => group.items.length > 0);

const breadcrumbs = [
  { name: 'Acasă', href: routes.home },
  { name: 'Întrebări frecvente', href: routes.faq },
];
---

<BaseLayout
  title="Întrebări frecvente"
  description="Răspunsuri despre programare, consultație, intervențiile la mână și recuperare."
  jsonLd={[breadcrumbSchema(Astro.site!, breadcrumbs), faqSchema(faqs)]}
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Întrebări frecvente"
    title="Răspunsuri la întrebările pe care le auzim des"
    intro="Nu ați găsit răspunsul? Ne puteți suna sau scrie, iar la consultație avem timp pentru toate întrebările."
  />

  <section class="section">
    <div class="container faq-page">
      <nav class="faq-nav" aria-label="Categorii">
        <ul>
          {
            categories.map((group) => (
              <li>
                <a href={`#${group.category}`}>{group.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="faq-groups">
        {
          categories.map((group) => (
            <section id={group.category} class="faq-group" data-reveal>
              <h2>{group.label}</h2>
              <FaqList faqs={group.items} />
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .faq-page {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }

  .faq-nav {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
  }

  .faq-nav ul {
    display: grid;
    gap: 0.35rem;
    list-style: none;
  }

  .faq-nav a {
    display: block;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    color: var(--color-text-muted);
    transition:
      background-color 200ms var(--ease),
      color 200ms var(--ease);
  }

  .faq-nav a:hover {
    background: var(--color-sand-soft);
    color: var(--color-navy);
  }

  .faq-groups {
    display: grid;
    gap: 3.5rem;
    max-width: 50rem;
  }

  .faq-group h2 {
    margin-bottom: 1.25rem;
    font-size: var(--text-xl);
  }

  @media (max-width: 860px) {
    .faq-page {
      grid-template-columns: 1fr;
    }

    .faq-nav {
      position: static;
    }

    .faq-nav ul {
      display: flex;
      flex-wrap: wrap;
    }

    .faq-nav a {
      background: var(--color-surface);
      border: 1px solid var(--color-line);
      border-radius: var(--radius-pill);
    }
  }
</style>
