---
import ArticleCard from '../../components/ArticleCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArticles } from '../../lib/content';
import { routes } from '../../lib/routes';
import { breadcrumbSchema } from '../../lib/schema';

const articles = await getArticles();
const breadcrumbs = [
  { name: 'Acasă', href: routes.home },
  { name: 'Articole', href: routes.articles },
];
---

<BaseLayout
  title="Articole despre sănătatea mâinii"
  description="Articole despre afecțiunile mâinii, pregătirea pentru consultație și recuperarea după intervenții, scrise pe înțeles."
  jsonLd={[breadcrumbSchema(Astro.site!, breadcrumbs)]}
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Articole"
    title="Informații utile pentru pacienți"
    intro="Răspunsuri la întrebările pe care le auzim des la consultație: ce simptome să nu ignorați, cum vă pregătiți și ce urmează după o intervenție."
  />

  <section class="section">
    <div class="container">
      {
        articles.length > 0 ? (
          <ul class="card-grid">
            {articles.map((article, index) => (
              <li>
                <ArticleCard article={article} delay={(index % 3) * 60} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="lead">Primele articole vor apărea în curând.</p>
        )
      }
    </div>
  </section>

  <CtaBand />
</BaseLayout>
