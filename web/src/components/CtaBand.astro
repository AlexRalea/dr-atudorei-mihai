---
import { getSettings } from '../lib/content';
import { telHref } from '../lib/format';
import { routes } from '../lib/routes';
import Icon from './Icon.astro';
import HandArt from './ink/HandArt.astro';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Vă supără mâna? Să vedem împreună ce se întâmplă.',
  text = 'Programați o consultație. Vă explicăm pe înțeles ce aveți și ce opțiuni de tratament există.',
} = Astro.props;

const settings = await getSettings();
const tel = telHref(settings.phone);

// Titlul implicit are două fraze; fiecare stă pe rândul ei.
const [firstLine, ...rest] = title.split(/(?<=\?)\s+/);
---

<section class="cta-section">
  <div class="container">
    <div class="cta-band" data-reveal>
      <div class="cta-decoration" aria-hidden="true">
        <HandArt />
      </div>
      <div class="cta-text">
        <h2>
          {firstLine}
          {rest.length > 0 && <br />}
          {rest.join(' ')}
        </h2>
        <p>{text}</p>
      </div>
      <div class="cta-actions">
        <a href={routes.appointment} class="btn btn-light">
          <Icon name="calendar-check" size={18} />
          Programează o consultație
        </a>
        {
          tel && (
            <a href={tel} class="btn btn-transparent">
              <Icon name="phone" size={18} />
              {settings.phone}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding-block: 64px;
  }

  .cta-band {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 60px;
    padding: 50px 53px;
    border-radius: 28px;
    background: var(--color-navy);
    color: var(--color-surface);
  }

  .cta-text,
  .cta-actions {
    position: relative;
    z-index: 1;
  }

  h2 {
    font-size: 2.5625rem;
    line-height: 1.15;
    color: var(--color-surface);
  }

  p {
    max-width: 590px;
    margin-top: 20px;
    font-size: 1.125rem;
    color: var(--color-dusty-light);
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 13px;
    min-width: 270px;
  }

  .cta-decoration {
    position: absolute;
    right: 110px;
    bottom: -200px;
    width: 430px;
    height: 490px;
    transform: rotate(25deg);
    opacity: 0.1;
  }

  .cta-decoration :global(.hand-art) {
    color: var(--color-surface);
  }

  @media (max-width: 950px) {
    .cta-band {
      gap: 30px;
      padding: 38px;
    }

    h2 {
      font-size: 2.125rem;
    }

    .cta-actions {
      min-width: 235px;
    }

    .cta-actions .btn {
      padding-inline: 17px;
      font-size: 0.875rem;
    }
  }

  @media (max-width: 640px) {
    .cta-section {
      padding-block: 40px;
    }

    .cta-band {
      grid-template-columns: 1fr;
      gap: 27px;
      padding: 32px 25px;
      border-radius: 24px;
    }

    h2 {
      font-size: 2.0625rem;
    }

    .cta-actions {
      min-width: 0;
      gap: 11px;
    }

    .cta-actions .btn {
      min-height: 50px;
      padding-inline: 12px;
      font-size: 0.9375rem;
    }

    .cta-decoration {
      right: -70px;
      bottom: -70px;
      width: 300px;
      height: 400px;
    }
  }
</style>
