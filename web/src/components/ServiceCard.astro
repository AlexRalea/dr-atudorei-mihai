---
import { routes } from '../lib/routes';
import type { Service } from '../lib/types';
import Icon from './Icon.astro';

interface Props {
  service: Service;
  delay?: number;
}

const { service, delay = 0 } = Astro.props;
---

<a href={routes.service(service.slug)} class="service-card" data-reveal style={`--reveal-delay: ${delay}ms`}>
  <span class="service-icon" aria-hidden="true">
    <Icon name={service.icon ?? 'stethoscope'} size={22} strokeWidth={1.5} />
  </span>
  <h3>{service.title}</h3>
  <p>{service.summary}</p>
  <span class="link-arrow">
    Află mai multe
    <Icon name="arrow-right" size={18} />
  </span>
</a>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    height: 100%;
    padding: 28px 28px 20px;
    border-radius: var(--radius-lg);
    background: var(--color-dusty-soft);
    transition:
      background var(--motion-medium),
      box-shadow var(--motion-medium),
      opacity var(--motion-slow) var(--ease),
      transform var(--motion-slow) var(--ease);
  }

  .service-card:hover {
    background: var(--color-dusty-light);
    box-shadow: var(--shadow-soft);
  }

  .service-icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-action);
    transition:
      background var(--motion-medium),
      color var(--motion-medium),
      transform var(--motion-medium) var(--ease);
  }

  .service-card:hover .service-icon {
    background: var(--color-action);
    color: var(--color-surface);
    transform: rotate(-7deg);
  }

  h3 {
    margin-top: 20px;
    font-family: var(--font-serif);
    font-variation-settings: 'SOFT' 100;
    font-size: 1.625rem;
    font-weight: 480;
    letter-spacing: -0.6px;
    line-height: 1.2;
    text-wrap: balance;
  }

  p {
    margin-block: 14px 10px;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .link-arrow {
    margin-top: auto;
    color: var(--color-action-hover);
  }
</style>
