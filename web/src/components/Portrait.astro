---
import { Image } from 'astro:assets';
import type { ImageData } from '../lib/types';
import Icon from './Icon.astro';

interface Props {
  image?: ImageData | null;
  name: string;
  /** Încarcă imediat imaginea (pentru zona vizibilă la deschiderea paginii). */
  priority?: boolean;
  class?: string;
}

const { image, name, priority = false, class: className } = Astro.props;
---

<div class:list={['portrait', className]}>
  {
    image ? (
      <Image
        src={image.url}
        alt={image.alt || name}
        width={image.width}
        height={image.height}
        widths={[480, 760, 1100]}
        sizes="(max-width: 900px) 90vw, 520px"
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
      />
    ) : (
      <div class="portrait-placeholder" role="img" aria-label={`Fotografia lui ${name} va fi adăugată în curând`}>
        <svg class="placeholder-shape" viewBox="0 0 400 500" aria-hidden="true">
          <path
            d="M70 120c40-70 150-100 230-60s110 140 80 230-120 170-220 160S10 340 20 250 30 190 70 120Z"
            fill="currentColor"
          />
        </svg>
        <Icon name="hand" size={120} strokeWidth={0.8} class="placeholder-icon" />
        <span class="placeholder-note">Fotografie în curând</span>
      </div>
    )
  }
</div>

<style>
  .portrait {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-xl);
    background: var(--color-dusty-soft);
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portrait-placeholder {
    position: relative;
    display: grid;
    place-items: center;
    height: 100%;
    background: linear-gradient(160deg, var(--color-dusty-light) 0%, var(--color-sand) 100%);
    color: var(--color-dusty-deep);
  }

  .placeholder-shape {
    position: absolute;
    inset: 10% 8%;
    width: 84%;
    height: 80%;
    color: rgb(255 255 255 / 0.4);
  }

  .portrait-placeholder :global(.placeholder-icon) {
    position: relative;
    opacity: 0.75;
  }

  .placeholder-note {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.65);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
</style>
