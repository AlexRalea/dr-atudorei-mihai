---
import { Image } from 'astro:assets';
import type { ImageData } from '../lib/types';
import HandArt from './ink/HandArt.astro';

interface Props {
  image?: ImageData | null;
  name: string;
  /** Încarcă imediat imaginea (pentru zona vizibilă la deschiderea paginii). */
  priority?: boolean;
  class?: string;
}

const { image, name, priority = false, class: className } = Astro.props;
---

<div class:list={['portrait', className]}>
  {
    image ? (
      <Image
        src={image.url}
        alt={image.alt || name}
        width={image.width}
        height={image.height}
        widths={[420, 640, 840]}
        sizes="(max-width: 640px) 86vw, 410px"
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
      />
    ) : (
      <div class="portrait-placeholder" role="img" aria-label={`${name} — fotografie în curând`}>
        <div class="placeholder-art" aria-hidden="true">
          <HandArt />
        </div>
        <span class="placeholder-note">Fotografie în curând</span>
      </div>
    )
  }
</div>

<style>
  /* Cadru în formă de arcadă: sus complet rotunjit, jos colțuri mici. */
  .portrait {
    --arch-ratio: 41 / 47;
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--arch-ratio);
    border-radius: 50% 50% 18px 18px / 43.6% 43.6% 18px 18px;
    background: var(--color-sand);
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%;
  }

  .portrait-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding-top: 24px;
  }

  .placeholder-art {
    width: 42%;
    aspect-ratio: 170 / 215;
  }

  .placeholder-art :global(.hand-art) {
    opacity: 0.47;
  }

  .placeholder-note {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .portrait-placeholder {
      gap: 8px;
    }

    .placeholder-note {
      font-size: 0.8125rem;
    }
  }
</style>
