---
import { Image } from 'astro:assets';
import bonesSketch from '../../assets/decor/oasele-mainii-schita.webp';

/**
 * Ornamente pentru fundalul hero-ului: o schiță anatomică a oaselor mâinii, un ac cu fir de sutură
 * și un bisturiu desenate în linie. Liniile se trasează o singură dată, la încărcare,
 * iar schița se dezvăluie de jos în sus.
 */
---

<div class="hero-decor" aria-hidden="true" data-ink>
  <div class="decor-frame">
    <svg class="decor decor-suture" viewBox="0 0 320 380" fill="none" focusable="false">
      <path class="ink-stroke" pathLength="1" d="M62 214C24 168 26 96 74 52"></path>
      <path class="ink-stroke ink-echo" pathLength="1" d="M70 220C30 170 34 98 80 58"></path>
      <ellipse class="ink-stroke" pathLength="1" cx="78" cy="49" rx="5" ry="3" transform="rotate(-40 78 49)"></ellipse>
      <path
        class="ink-stroke"
        pathLength="1"
        d="M80 46C118 4 196 10 204 66C212 120 136 126 142 176C148 226 248 214 268 262C288 312 214 356 158 340C110 326 116 268 170 276"
      ></path>
    </svg>

    <div class="decor decor-bones">
      <Image src={bonesSketch} alt="" widths={[200, 400]} sizes="200px" loading="eager" decoding="async" fetchpriority="low" />
    </div>

    <svg class="decor decor-scalpel" viewBox="0 0 260 80" fill="none" focusable="false">
      <path class="ink-stroke" pathLength="1" d="M74 34L238 29C250 29 254 35 254 40C254 45 250 51 238 51L74 46"></path>
      <path class="ink-stroke" pathLength="1" d="M74 34C50 29 22 32 6 47C30 52 54 49 74 46"></path>
      <path class="ink-stroke" pathLength="1" d="M74 34V46"></path>
      <path class="ink-stroke ink-echo" pathLength="1" d="M112 39L170 37.5M196 35V45M204 35V45M212 35V45"></path>
    </svg>
  </div>
</div>

<style>
  .hero-decor {
    position: absolute;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .decor-frame {
    position: relative;
    height: 100%;
  }

  .decor {
    position: absolute;
    overflow: visible;
    color: var(--color-action);
    opacity: var(--opacity);
    rotate: var(--rotate);
  }

  .decor-bones :global(img) {
    width: 100%;
    height: auto;
  }

  .decor :global(.ink-echo) {
    opacity: 0.45;
  }

  /* Trei forme așezate în triunghi pe toată suprafața hero-ului:
     oasele mâinii jos în stânga, firul de sutură sus la mijloc, bisturiul jos în dreapta. */
  .decor-bones {
    --rotate: -16deg;
    --opacity: 0.32;
    left: max(-20px, calc(50% - 770px));
    bottom: -110px;
    width: 200px;
  }

  .decor-suture {
    --rotate: 6deg;
    --opacity: 0.4;
    left: 44%;
    top: -50px;
    width: 230px;
  }

  .decor-scalpel {
    --rotate: -24deg;
    --opacity: 0.38;
    right: max(-40px, calc(50% - 760px));
    bottom: 18px;
    width: 200px;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-lines-revealed] .decor :global(.ink-stroke) {
      animation: ink-draw 2200ms var(--ease) 300ms both;
    }

    [data-lines-revealed] .decor-bones :global(img) {
      animation: sketch-reveal 2400ms var(--ease) 500ms both;
    }

    @keyframes sketch-reveal {
      from {
        clip-path: inset(100% 0 0 0);
      }
      to {
        clip-path: inset(0 0 0 0);
      }
    }

    [data-lines-revealed] .decor-scalpel :global(.ink-stroke) {
      animation-delay: 800ms;
    }

    [data-lines-revealed] .decor {
      animation: ink-curve-settle 4400ms var(--ease-in-out) both;
    }
  }

  @media (max-width: 950px) {
    .decor-suture {
      left: 40%;
      width: 200px;
    }

    .decor-bones {
      width: 165px;
    }

    .decor-scalpel {
      width: 170px;
      bottom: 8px;
    }
  }

  @media (max-width: 640px) {
    .decor-suture {
      --opacity: 0.32;
      left: auto;
      right: -50px;
      top: -30px;
      width: 170px;
    }

    .decor-bones {
      --opacity: 0.24;
      left: -40px;
      bottom: -110px;
      width: 150px;
    }

    .decor-scalpel {
      --opacity: 0.28;
      right: -50px;
      bottom: 300px;
      width: 150px;
    }
  }
</style>
