---
import { Image } from 'astro:assets';
import { conditionArt } from '../../lib/condition-art';
import { routes } from '../../lib/routes';
import type { Condition } from '../../lib/types';
import Icon from '../Icon.astro';
import HandArt from '../ink/HandArt.astro';
import SymptomChoice from './SymptomChoice.astro';

interface Props {
  conditions: Condition[];
}

const { conditions } = Astro.props;
const half = Math.ceil(conditions.length / 2);
const columns = [
  conditions.slice(0, half).map((condition, index) => ({ condition, index })),
  conditions.slice(half).map((condition, index) => ({ condition, index: index + half })),
];
const art = conditions.map((condition) => conditionArt(condition.slug));
---

<div class="symptom-explorer" data-symptoms>
  <div class="symptom-choices">
    {columns[0].map(({ condition, index }) => <SymptomChoice condition={condition} index={index} selected={index === 0} />)}
  </div>

  <div class="symptom-map" data-reveal>
    <div class="map-canvas">
      <div class="map-orbit" data-ink-shape="line" aria-hidden="true"></div>
      <div class="map-blob" data-ink-shape="fill" aria-hidden="true"></div>
      <div class="map-art" aria-hidden="true">
        {
          conditions.map((condition, index) => (
            <div class:list={['map-art-item', { 'is-active': index === 0 }]} data-art={index}>
              {art[index] ? (
                <Image
                  src={art[index]}
                  alt=""
                  widths={[200, 280, 400]}
                  sizes="(max-width: 640px) 112px, (max-width: 1200px) 170px, 200px"
                  quality={55} loading="lazy" decoding="async" />
              ) : (
                <HandArt />
              )}
            </div>
          ))
        }
      </div>
      <div class="map-markers" role="group" aria-label="Porniți de la ce simțiți">
        {
          conditions.map((condition, index) => (
            <button
              type="button"
              class:list={['map-marker', { 'is-selected': index === 0 }]}
              aria-label={`„${condition.symptomPrompt}”`}
              aria-pressed={index === 0 ? 'true' : 'false'}
              aria-controls={`symptom-detail-${index}`}
              data-select={index}
              style={`--marker-angle: ${(index * 360) / conditions.length - 120}deg`}
            >
              <span>{String(index + 1).padStart(2, '0')}</span>
            </button>
          ))
        }
      </div>
    </div>
    <div class="preview-copy" aria-live="polite" aria-atomic="true">
      {
        conditions.map((condition, index) => (
          <div class="preview-item" data-preview={index} hidden={index !== 0}>
            <p>Poate fi:</p>
            <h3>{condition.title}</h3>
            <a href={routes.condition(condition.slug)} class="link-arrow">
              Află mai multe
              <Icon name="arrow-right" size={18} />
            </a>
          </div>
        ))
      }
    </div>
  </div>

  <div class="symptom-choices">
    {columns[1].map(({ condition, index }) => <SymptomChoice condition={condition} index={index} selected={index === 0} />)}
  </div>
</div>

<style is:global>
  .symptom-explorer {
    --choices-h: 640px;
    display: grid;
    grid-template-columns: 1fr 1.1fr 1fr;
    gap: 28px;
    align-items: center;
  }

  /* Coloanele au înălțime fixă: cardul deschis crește, celelalte se strâng, iar secțiunea nu se mișcă. */
  .symptom-choices {
    display: flex;
    flex-direction: column;
    gap: 15px;
    height: var(--choices-h);
  }

  .symptom-choice {
    display: flex;
    flex-direction: column;
    flex: 1 1 0;
    min-height: 0;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 16px;
    background: var(--color-bg);
    transition:
      flex-grow var(--motion-medium) var(--ease),
      flex-basis var(--motion-medium) var(--ease),
      background var(--motion-medium),
      border-color var(--motion-medium),
      box-shadow var(--motion-medium),
      opacity var(--motion-slow) var(--ease),
      transform var(--motion-slow) var(--ease);
  }

  /* În coloana fără card deschis, cardurile își împart înălțimea și textul stă centrat. */
  .symptom-choice:not(.is-selected) {
    justify-content: center;
  }

  .symptom-choices:has(.is-selected) .symptom-choice {
    flex: 0 0 auto;
  }

  .symptom-choices .symptom-choice.is-selected {
    flex: 1 1 0;
    border-color: var(--color-dusty);
    background: var(--color-dusty-soft);
    box-shadow: var(--shadow-soft);
  }

  .symptom-card {
    display: block;
    flex: none;
    width: 100%;
    padding: 21px 21px 0;
    text-align: left;
    color: var(--color-navy);
  }

  .symptom-heading {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .symptom-number {
    padding-top: 4px;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-action);
  }

  .symptom-title {
    flex: 1;
    font-family: var(--font-serif);
    font-variation-settings: 'SOFT' 100;
    font-size: 1.3125rem;
    font-weight: 480;
    letter-spacing: -0.5px;
    line-height: 1.35;
    transition: font-size var(--motion-medium) var(--ease);
  }

  /* Cardurile închise de lângă cel deschis devin mai mici. */
  .symptom-choices:has(.is-selected) .symptom-choice:not(.is-selected) .symptom-title {
    font-size: 1.0625rem;
  }

  .symptom-heading > .icon {
    margin-top: 6px;
    color: var(--color-action);
    transition: transform var(--motion-medium) var(--ease);
  }

  .symptom-card:hover .symptom-heading > .icon {
    transform: rotate(-35deg) translateX(3px);
  }

  .is-selected .symptom-heading > .icon,
  .is-selected .symptom-card:hover .symptom-heading > .icon {
    transform: rotate(90deg);
  }

  .symptom-meta {
    display: block;
    margin-block: 12px 18px;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .symptom-choices:has(.is-selected) .symptom-choice:not(.is-selected) .symptom-meta {
    margin-block: 6px 16px;
  }

  .symptom-meta strong {
    font-weight: 550;
    color: var(--color-action);
  }

  .is-selected .symptom-meta strong,
  .is-selected .symptom-number {
    color: var(--color-action-hover);
  }

  /* Detaliile afecțiunii apar doar în cardul deschis. */
  .symptom-detail {
    display: grid;
    grid-template-rows: 0fr;
    min-height: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      grid-template-rows var(--motion-medium) var(--ease),
      opacity 300ms,
      visibility var(--motion-medium);
  }

  .is-selected .symptom-detail {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
    transition-delay: 0ms, 150ms, 0ms;
  }

  .symptom-detail-inner {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 0;
    overflow: hidden;
    padding: 0 21px;
  }

  .symptom-summary {
    display: -webkit-box;
    padding-top: 14px;
    border-top: 1px solid var(--color-dusty-light);
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .symptom-list {
    display: grid;
    gap: 6px;
    list-style: none;
  }

  .symptom-list li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-navy);
  }

  .symptom-list .icon {
    margin-top: 2px;
    color: var(--color-action);
  }

  .symptom-detail .link-arrow {
    margin-bottom: 8px;
    color: var(--color-action-hover);
  }

  .symptom-map {
    min-width: 0;
  }

  .map-canvas {
    --orbit: 278px;
    --blob-inset: 22px;
    position: relative;
    height: 330px;
  }

  .map-orbit,
  .map-blob {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .map-orbit {
    width: var(--orbit);
    height: var(--orbit);
    border: 1px solid var(--color-dusty);
    border-radius: 50%;
  }

  .map-blob {
    width: calc(var(--orbit) - var(--blob-inset) * 2);
    height: calc(var(--orbit) - var(--blob-inset) * 2);
    border-radius: 45% 50% 41% 47%;
    background: var(--color-dusty-soft);
  }

  /* Cu JavaScript, cercul și pata sunt desenate ondulat de ink-shapes.ts. */
  .map-orbit.has-ink,
  .map-blob.has-ink {
    border-color: transparent;
    background: transparent;
  }

  .map-art {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 200px;
    height: 200px;
    transform: translate(-50%, -50%);
  }

  .map-art-item {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    scale: 0.94;
    transition:
      opacity var(--motion-medium) var(--ease),
      scale var(--motion-slow) var(--ease);
  }

  .map-art-item.is-active {
    opacity: 1;
    scale: 1;
  }

  .map-art-item img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .map-art-item .hand-art {
    width: 72%;
    height: 100%;
  }

  .map-marker {
    --marker-radius: calc(var(--orbit) / 2);
    position: absolute;
    z-index: 1;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-dusty);
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-action);
    font-size: 0.875rem;
    transform: translate(-50%, -50%) rotate(var(--marker-angle)) translateX(var(--marker-radius))
      rotate(calc(0deg - var(--marker-angle)));
    transition:
      background var(--motion-medium),
      color var(--motion-medium),
      scale var(--motion-medium) var(--ease);
  }

  .map-marker:hover {
    scale: 1.1;
  }

  .map-marker.is-selected {
    background: var(--color-action);
    color: var(--color-surface);
    scale: 1.08;
  }

  .preview-copy {
    padding: 13px 5px 0;
    text-align: center;
  }

  .preview-item p {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .preview-item h3 {
    min-height: 2.4em;
    margin-top: 6px;
    font-family: var(--font-serif);
    font-variation-settings: 'SOFT' 100;
    font-weight: 480;
    font-size: 1.8125rem;
    letter-spacing: -0.7px;
    line-height: 1.2;
    text-wrap: balance;
  }

  .preview-item .link-arrow {
    margin-top: 9px;
    align-self: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .preview-item:not([hidden]) {
      animation: enter 500ms var(--ease) both;
    }
  }

  @media (max-width: 1200px) {
    .symptom-explorer {
      --choices-h: 700px;
      grid-template-columns: 1fr 0.95fr 1fr;
      gap: 20px;
    }

    .symptom-card {
      padding: 18px 18px 0;
    }

    .symptom-detail-inner {
      padding: 0 18px;
    }

    .symptom-heading {
      gap: 9px;
    }

    .symptom-title {
      font-size: 1.25rem;
    }

    .map-canvas {
      --orbit: 234px;
      --blob-inset: 18px;
      height: 290px;
    }

    .map-art {
      width: 170px;
      height: 170px;
    }
  }

  @media (max-width: 950px) {
    .symptom-explorer {
      --choices-h: 620px;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .symptom-map {
      grid-column: span 2;
      grid-row: 1;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      width: 100%;
      max-width: 600px;
      margin-inline: auto;
    }

    .map-canvas {
      height: 285px;
    }

    .preview-copy {
      padding-left: 30px;
      text-align: left;
    }

    .preview-item h3 {
      min-height: 0;
      font-size: 2rem;
    }

    .preview-item .link-arrow {
      align-self: flex-start;
    }
  }

  /* Pe telefon, cardurile stau unul sub altul și doar cel ales se deschide. */
  @media (max-width: 640px) {
    .symptom-explorer {
      grid-template-columns: 1fr;
      gap: 15px;
    }

    .symptom-choices {
      height: auto;
    }

    .symptom-choices .symptom-choice,
    .symptom-choices:has(.is-selected) .symptom-choice,
    .symptom-choices .symptom-choice.is-selected {
      flex: none;
    }

    .symptom-map {
      grid-column: 1;
      grid-template-columns: 160px 1fr;
      gap: 17px;
      margin-bottom: 12px;
    }

    .map-canvas {
      --orbit: 152px;
      --blob-inset: 12px;
      height: 230px;
    }

    .map-art {
      width: 112px;
      height: 112px;
    }

    .map-marker {
      font-size: 0.75rem;
    }

    .preview-copy {
      min-width: 0;
      padding: 0;
    }

    .preview-item p {
      font-size: 0.875rem;
    }

    .preview-item h3 {
      font-size: 1.5rem;
      overflow-wrap: anywhere;
    }

    .preview-item .link-arrow {
      gap: 9px;
      margin-top: 12px;
      font-size: 0.875rem;
    }

    .symptom-card {
      padding: 21px 21px 0;
    }

    .symptom-detail-inner {
      padding: 0 21px;
    }

    .symptom-title,
    .symptom-choices:has(.is-selected) .symptom-choice:not(.is-selected) .symptom-title {
      font-size: 1.375rem;
    }

    .symptom-meta {
      font-size: 0.9375rem;
    }

    .symptom-summary {
      font-size: 1rem;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-symptoms]').forEach((explorer) => {
    const ripple = () =>
      explorer.querySelectorAll('[data-ink-shape]').forEach((shape) => shape.dispatchEvent(new CustomEvent('ink:ripple')));

    const select = (selected: string, animate = true) => {
      explorer.querySelectorAll<HTMLElement>('[data-symptom]').forEach((choice) => {
        const active = choice.dataset.symptom === selected;
        choice.classList.toggle('is-selected', active);
        choice.querySelector('.symptom-card')?.setAttribute('aria-expanded', String(active));
        choice.querySelector<HTMLElement>('.symptom-detail')!.inert = !active;
      });
      explorer.querySelectorAll<HTMLButtonElement>('.map-marker').forEach((marker) => {
        const active = marker.dataset.select === selected;
        marker.setAttribute('aria-pressed', String(active));
        marker.classList.toggle('is-selected', active);
      });
      explorer.querySelectorAll<HTMLElement>('[data-art]').forEach((item) => {
        item.classList.toggle('is-active', item.dataset.art === selected);
      });
      explorer.querySelectorAll<HTMLElement>('[data-preview]').forEach((preview) => {
        preview.hidden = preview.dataset.preview !== selected;
      });
      if (animate) ripple();
    };

    explorer.querySelectorAll<HTMLButtonElement>('[data-select]').forEach((button) => {
      button.addEventListener('click', () => select(button.dataset.select!));
    });

    select('0', false);
  });
</script>
