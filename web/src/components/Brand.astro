---
import { getSettings } from '../lib/content';
import { routes } from '../lib/routes';
import Logo from './Logo.astro';

interface Props {
  /** Varianta pentru fundalul închis din footer. */
  footer?: boolean;
}

const { footer = false } = Astro.props;
const settings = await getSettings();
---

<a href={routes.home} class:list={['brand', { 'brand-footer': footer }]} aria-label={`${settings.siteName} — Acasă`}>
  <Logo class="brand-mark" weight={3} />
  <span>
    <strong>{settings.siteName}</strong>
    <small>{settings.specialty}</small>
  </span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    flex-shrink: 0;
    color: var(--color-navy);
  }

  .brand :global(.brand-mark) {
    width: 46px;
    height: 48px;
    color: var(--color-action);
    transition: transform var(--motion-medium) var(--ease);
  }

  .brand:hover :global(.brand-mark) {
    transform: rotate(-6deg);
  }

  strong {
    display: block;
    font-family: var(--font-serif);
    font-variation-settings: 'SOFT' 100;
    font-weight: 480;
    font-size: 1.25rem;
    letter-spacing: -0.6px;
    line-height: 1.3;
  }

  small {
    display: block;
    margin-top: 3px;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .brand-footer {
    color: var(--color-surface);
  }

  .brand-footer :global(.brand-mark) {
    color: var(--color-dusty-light);
  }

  .brand-footer small {
    color: var(--color-dusty-light);
  }

  @media (max-width: 640px) {
    .brand {
      gap: 10px;
    }

    .brand :global(.brand-mark) {
      width: 40px;
      height: 42px;
    }

    strong {
      font-size: 1.125rem;
    }

    small {
      font-size: 0.75rem;
    }
  }
</style>
