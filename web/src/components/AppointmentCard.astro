---
import { getSettings } from '../lib/content';
import { telHref } from '../lib/format';
import { routes } from '../lib/routes';
import Icon from './Icon.astro';

const settings = await getSettings();
const tel = telHref(settings.phone);
---

<div class="appointment-card">
  <p class="card-title">Aveți nevoie de o evaluare?</p>
  <p class="muted">Programați o consultație. Vă contactăm pentru a stabili ziua și ora.</p>
  <a href={routes.appointment} class="btn btn-primary">
    <Icon name="calendar-check" size={18} />
    Programează-te
  </a>
  {
    tel && (
      <a href={tel} class="btn btn-secondary">
        <Icon name="phone" size={18} />
        {settings.phone}
      </a>
    )
  }
</div>

<style>
  .appointment-card {
    display: grid;
    gap: 0.9rem;
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    background: var(--color-sand-soft);
    border: 1px solid var(--color-line);
  }

  .card-title {
    font-family: var(--font-serif);
    font-variation-settings: 'SOFT' 100;
    font-size: 1.375rem;
    line-height: 1.25;
  }

  .muted {
    font-size: 1rem;
  }

  .btn {
    width: 100%;
  }
</style>
