---
interface Props {
  title: string;
  intro?: string;
  align?: 'start' | 'center';
  id?: string;
}

const { title, intro, align = 'start', id } = Astro.props;
---

<header class:list={['section-header', `align-${align}`]} data-reveal>
  <div class="section-header-text">
    <h2 id={id}>{title}</h2>
    {intro && <p class="lead">{intro}</p>}
  </div>
  <slot />
</header>

<style>
  .section-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 3rem;
    margin-bottom: clamp(1.5rem, 1.25rem + 1.25vw, 2.5rem);
  }

  .section-header-text {
    max-width: 44rem;
  }

  .section-header-text > * + * {
    margin-top: 0.75rem;
  }

  .align-center {
    justify-content: center;
    text-align: center;
  }

  .align-center .section-header-text {
    margin-inline: auto;
  }
</style>
