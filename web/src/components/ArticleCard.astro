---
import { Image } from 'astro:assets';
import { formatDate } from '../lib/format';
import { articleArt } from '../lib/illustrations';
import { routes } from '../lib/routes';
import type { Article } from '../lib/types';
import Icon from './Icon.astro';
import HandArt from './ink/HandArt.astro';

interface Props {
  article: Article;
  delay?: number;
  /** Poziția în listă: alege varianta ilustrației când articolul nu are imagine. */
  index?: number;
}

const { article, delay = 0, index = 0 } = Astro.props;
const sketch = article.cover ? null : articleArt(article.slug);
---

<a href={routes.article(article.slug)} class="article-card" data-reveal style={`--reveal-delay: ${delay}ms`}>
  <div class:list={['article-cover', `cover-${index % 3}`]}>
    {
      article.cover ? (
        <Image
          src={article.cover.url}
          alt={article.cover.alt}
          width={article.cover.width}
          height={article.cover.height}
          widths={[400, 700]}
          sizes="(max-width: 640px) 100vw, 520px"
        />
      ) : (
        <span class="cover-art" aria-hidden="true">
          <span class="cover-circle" />
          {sketch ? (
            <Image
              class="cover-sketch"
              src={sketch}
              alt=""
              widths={[320, 520]}
              sizes="(max-width: 640px) 80vw, 320px"
              quality={55}
            />
          ) : (
            <HandArt />
          )}
          <span class="cover-line" />
        </span>
      )
    }
  </div>
  <div class="article-content">
    <p class="article-meta">
      {article.category && <span class="article-category">{article.category}</span>}
      <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>
    </p>
    <h3>{article.title}</h3>
    <p class="article-excerpt">{article.excerpt}</p>
    <span class="link-arrow">
      Citește articolul
      <Icon name="arrow-right" size={18} />
    </span>
  </div>
</a>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 18px;
    background: var(--color-surface);
    transition:
      box-shadow var(--motion-medium) var(--ease),
      border-color var(--motion-medium),
      opacity var(--motion-slow) var(--ease),
      transform var(--motion-slow) var(--ease);
  }

  .article-card:hover {
    border-color: var(--color-dusty);
    box-shadow: var(--shadow-soft);
  }

  .article-cover {
    position: relative;
    height: 180px;
    overflow: hidden;
    background: var(--color-dusty-light);
  }

  .cover-1 {
    background: var(--color-dusty-soft);
  }

  .article-cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease);
  }

  .article-card:hover .article-cover :global(img) {
    transform: scale(1.03);
  }

  .cover-art {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }

  .cover-art :global(.hand-art) {
    --tilt: -17deg;
    position: relative;
    z-index: 1;
    width: 180px;
    height: 225px;
    transform: rotate(var(--tilt)) translateY(17px);
    transition: transform 1s var(--ease);
  }

  .cover-1 .cover-art :global(.hand-art) {
    --tilt: 13deg;
  }

  .cover-2 .cover-art :global(.hand-art) {
    --tilt: 25deg;
  }

  .article-card:hover .cover-art :global(.hand-art) {
    transform: rotate(calc(var(--tilt) + 7deg)) translateY(10px);
  }

  .cover-art :global(.cover-sketch) {
    position: absolute;
    inset: 14px 22px;
    z-index: 1;
    width: calc(100% - 44px);
    height: calc(100% - 28px);
    object-fit: contain;
    transition: transform 1s var(--ease);
  }

  .article-card:hover .cover-art :global(.cover-sketch) {
    transform: scale(1.04) rotate(-1deg);
  }

  .cover-circle,
  .cover-line {
    position: absolute;
    left: 50%;
    border-radius: 50%;
    transform: translateX(-50%);
  }

  .cover-circle {
    top: 30px;
    width: 190px;
    height: 190px;
    border: 1px solid rgb(85 117 145 / 0.22);
  }

  .cover-line {
    top: 8px;
    width: 250px;
    height: 250px;
    border: 1px solid rgb(85 117 145 / 0.12);
  }

  .article-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 20px 22px 16px;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 7px 15px;
    margin-bottom: 10px;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .article-category {
    font-weight: 550;
    color: var(--color-action);
  }

  .article-category + time::before {
    content: '·';
    margin-right: 15px;
  }

  h3 {
    font-family: var(--font-serif);
    font-variation-settings: 'SOFT' 100;
    font-size: 1.375rem;
    font-weight: 480;
    line-height: 1.3;
    letter-spacing: -0.4px;
    text-wrap: pretty;
  }

  .article-excerpt {
    display: -webkit-box;
    margin-block: 10px 8px;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .link-arrow {
    margin-top: auto;
  }

  @media (max-width: 950px) {
    h3 {
      font-size: 1.3125rem;
    }
  }

  @media (max-width: 640px) {
    .article-card {
      border-radius: 16px;
    }

    .article-cover {
      height: 160px;
    }

    .cover-art :global(.hand-art) {
      width: 145px;
      height: 180px;
    }

    .article-content {
      padding: 18px 20px 14px;
    }

    .article-meta {
      gap: 6px 10px;
      margin-bottom: 14px;
      font-size: 0.75rem;
    }

    .article-category + time::before {
      margin-right: 10px;
    }

    h3 {
      font-size: 1.3125rem;
    }
  }
</style>
