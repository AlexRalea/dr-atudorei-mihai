---
import { getSettings } from '../lib/content';
import { telHref } from '../lib/format';
import { routes } from '../lib/routes';
import Brand from './Brand.astro';
import Icon from './Icon.astro';

const settings = await getSettings();
const tel = telHref(settings.phone);
const path = Astro.url.pathname;

const nav = [
  { href: routes.about, label: 'Despre' },
  { href: routes.services, label: 'Servicii' },
  { href: routes.conditions, label: 'Afecțiuni' },
  { href: routes.articles, label: 'Articole' },
  { href: routes.contact, label: 'Contact' },
];

const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <Brand />

    <nav class="desktop-nav" aria-label="Navigare principală">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      {
        tel && (
          <a href={tel} class="btn btn-sm header-phone">
            <Icon name="phone" size={15} />
            {settings.phone}
          </a>
        )
      }
      <a href={routes.appointment} class="btn btn-primary btn-sm">
        <Icon name="calendar-check" size={15} />
        Programează o consultație
      </a>
    </div>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span class="visually-hidden">Deschide meniul</span>
      <span class="menu-icon menu-icon-open"><Icon name="menu" size={24} /></span>
      <span class="menu-icon menu-icon-close"><Icon name="x" size={24} /></span>
    </button>
  </div>

  <div class="mobile-menu-shell" data-menu>
    <nav id="mobile-menu" class="mobile-menu" aria-label="Navigare mobilă">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
            <Icon name="arrow-right" size={17} />
          </a>
        ))
      }
      <a href={routes.appointment} class="btn btn-primary">
        <Icon name="calendar-check" size={18} />
        Programează o consultație
      </a>
    </nav>
  </div>

  <div class="reading-progress" aria-hidden="true"></div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(250 247 242 / 0.96);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    height: var(--header-h);
    border-bottom: 1px solid var(--color-line);
    transition: height var(--motion-medium) var(--ease);
  }

  :global([data-scrolled]) .header-inner {
    height: var(--header-h-scrolled);
  }

  .desktop-nav {
    display: flex;
    gap: 22px;
  }

  .desktop-nav a {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9375rem;
    color: var(--color-action-hover);
  }

  .desktop-nav a::after {
    content: '';
    position: absolute;
    bottom: 5px;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--color-action);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-medium) var(--ease);
  }

  .desktop-nav a:hover::after,
  .desktop-nav a[aria-current]::after {
    transform: scaleX(1);
  }

  .header-actions {
    display: flex;
    gap: 14px;
  }

  .header-actions .btn {
    font-size: 0.8125rem;
    padding-inline: 16px;
  }

  .header-actions .header-phone {
    --btn-bg: transparent;
    --btn-fg: var(--color-action-hover);
    padding-inline: 0;
  }

  .header-actions .header-phone:hover {
    box-shadow: none;
  }

  .reading-progress {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: var(--color-action);
    opacity: 0.65;
    transform: scaleX(var(--page-progress, 0));
    transform-origin: left;
    pointer-events: none;
  }

  .menu-toggle,
  .mobile-menu-shell {
    display: none;
  }

  .menu-toggle {
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--color-action);
  }

  .menu-icon-close,
  .menu-toggle[aria-expanded='true'] .menu-icon-open {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] .menu-icon-close {
    display: block;
  }

  @media (max-width: 1200px) {
    .header-inner {
      gap: 22px;
    }

    .desktop-nav {
      gap: 18px;
    }

    .header-actions .header-phone {
      display: none;
    }
  }

  @media (max-width: 950px) {
    .desktop-nav,
    .header-actions {
      display: none;
    }

    .menu-toggle {
      display: grid;
    }

    .mobile-menu-shell {
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      transition:
        grid-template-rows var(--motion-medium) var(--ease),
        visibility var(--motion-medium);
    }

    /* Fără JavaScript, meniul rămâne deschis sub logo. */
    :global(html:not(.js)) .mobile-menu-shell,
    .mobile-menu-shell.is-open {
      grid-template-rows: 1fr;
      visibility: visible;
    }

    :global(html:not(.js)) .menu-toggle {
      display: none;
    }

    .mobile-menu {
      min-height: 0;
      overflow: hidden;
      padding-inline: 32px;
    }

    .mobile-menu > a:not(.btn) {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 55px;
      border-bottom: 1px solid var(--color-line);
      color: var(--color-action-hover);
      opacity: 0;
      transform: translateY(-7px);
      transition:
        opacity 300ms,
        transform var(--motion-medium) var(--ease);
    }

    .mobile-menu > a[aria-current] {
      color: var(--color-navy);
      font-weight: 600;
    }

    :global(html:not(.js)) .mobile-menu > a,
    .is-open .mobile-menu > a {
      opacity: 1;
      transform: none;
    }

    .mobile-menu > a:nth-child(2) {
      transition-delay: 30ms;
    }

    .mobile-menu > a:nth-child(3) {
      transition-delay: 60ms;
    }

    .mobile-menu > a:nth-child(4) {
      transition-delay: 90ms;
    }

    .mobile-menu > a:nth-child(5) {
      transition-delay: 120ms;
    }

    .mobile-menu > .btn {
      display: flex;
      margin-block: 20px 25px;
    }
  }

  @media (max-width: 640px) {
    .mobile-menu {
      max-height: calc(100dvh - 155px);
      padding-inline: 20px;
      overflow-y: auto;
    }
  }
</style>

<script>
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');

  const setOpen = (open: boolean) => {
    if (!menu || !toggle) return;
    menu.classList.toggle('is-open', open);
    menu.inert = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('.visually-hidden')!.textContent = open ? 'Închide meniul' : 'Deschide meniul';
  };

  setOpen(false);
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });

  menu?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setOpen(false);
  });

  // Meniul mobil nu trebuie să rămână deschis dacă fereastra se lărgește.
  matchMedia('(min-width: 951px)').addEventListener('change', (event) => {
    if (event.matches) setOpen(false);
  });
</script>
