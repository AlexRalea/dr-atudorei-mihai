---
import { routes } from '../lib/routes';
import type { Condition } from '../lib/types';
import Icon from './Icon.astro';

interface Props {
  condition: Condition;
  /** „symptom” pune în față simptomul, cum îl descrie pacientul. */
  variant?: 'default' | 'symptom';
  delay?: number;
}

const { condition, variant = 'default', delay = 0 } = Astro.props;
const showSymptom = variant === 'symptom' && condition.symptomPrompt;
---

<a
  href={routes.condition(condition.slug)}
  class:list={['condition-card', `variant-${variant}`]}
  data-reveal
  style={`--reveal-delay: ${delay}ms`}
>
  <div class="card-heading">
    {showSymptom ? <span class="card-title">„{condition.symptomPrompt}”</span> : <h3 class="card-title">{condition.title}</h3>}
    <Icon name="arrow-right" size={18} />
  </div>
  {
    showSymptom ? (
      <span class="card-meta">
        Poate fi: <strong>{condition.title}</strong>
      </span>
    ) : (
      <>
        {condition.aka && <span class="card-aka">{condition.aka}</span>}
        <span class="card-summary">{condition.summary}</span>
      </>
    )
  }
</a>

<style>
  .condition-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    padding: 21px 22px 23px;
    border: 1px solid var(--color-line);
    border-radius: 16px;
    background: var(--color-surface);
    transition:
      background var(--motion-medium),
      border-color var(--motion-medium),
      box-shadow var(--motion-medium),
      opacity var(--motion-slow) var(--ease),
      transform var(--motion-slow) var(--ease);
  }

  .condition-card:hover {
    border-color: var(--color-dusty);
    background: var(--color-dusty-soft);
    box-shadow: var(--shadow-soft);
  }

  .card-heading {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .card-title {
    flex: 1;
    font-family: var(--font-serif);
    font-variation-settings: 'SOFT' 100;
    font-size: 1.4375rem;
    font-weight: 480;
    letter-spacing: -0.5px;
    line-height: 1.3;
  }

  .card-heading > :global(.icon) {
    margin-top: 6px;
    color: var(--color-action);
    transition: transform var(--motion-medium) var(--ease);
  }

  .condition-card:hover .card-heading > :global(.icon) {
    transform: rotate(-35deg) translateX(3px);
  }

  .card-aka {
    font-size: 0.875rem;
    font-weight: 550;
    color: var(--color-action);
  }

  .card-summary {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .card-meta {
    margin-top: auto;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .card-meta strong {
    font-weight: 550;
    color: var(--color-action);
  }
</style>
