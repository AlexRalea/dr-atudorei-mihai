---
import { routes } from '../lib/routes';
import type { Condition } from '../lib/types';
import Icon from './Icon.astro';

interface Props {
  condition: Condition;
  /** „symptom” pune în față simptomul, cum îl descrie pacientul. */
  variant?: 'default' | 'symptom';
  delay?: number;
}

const { condition, variant = 'default', delay = 0 } = Astro.props;
const showSymptom = variant === 'symptom' && condition.symptomPrompt;
---

<a
  href={routes.condition(condition.slug)}
  class:list={['condition-card', `variant-${variant}`]}
  data-reveal
  style={`--reveal-delay: ${delay}ms`}
>
  {
    showSymptom ? (
      <>
        <span class="card-quote">„{condition.symptomPrompt}”</span>
        <span class="card-meta">
          Poate fi: <strong>{condition.title}</strong>
        </span>
      </>
    ) : (
      <>
        <h3 class="card-title">{condition.title}</h3>
        {condition.aka && <span class="card-aka">{condition.aka}</span>}
        <span class="card-summary">{condition.summary}</span>
      </>
    )
  }
  <span class="card-arrow" aria-hidden="true"><Icon name="arrow-right" size={18} /></span>
</a>

<style>
  .condition-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: 1.25rem 1.35rem 3.25rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    transition:
      transform 320ms var(--ease),
      box-shadow 320ms var(--ease),
      border-color 320ms var(--ease);
  }

  .condition-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-dusty);
    box-shadow: var(--shadow);
  }

  .card-title {
    font-size: 1.375rem;
  }

  .card-aka {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-dusty-deep);
  }

  .card-summary {
    color: var(--color-text-muted);
    font-size: 1.0625rem;
  }

  .card-quote {
    font-family: var(--font-serif);
    font-variation-settings: 'SOFT' 100;
    font-size: 1.3125rem;
    line-height: 1.35;
    color: var(--color-navy);
  }

  .card-meta {
    margin-top: auto;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .card-meta strong {
    color: var(--color-dusty-deep);
    font-weight: 650;
  }

  .card-arrow {
    position: absolute;
    right: 1.1rem;
    bottom: 1rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-dusty-soft);
    color: var(--color-dusty-deep);
    transition:
      background-color 320ms var(--ease),
      color 320ms var(--ease),
      transform 320ms var(--ease);
  }

  .condition-card:hover .card-arrow {
    background: var(--color-action);
    color: #fff;
    transform: translateX(3px);
  }

  .variant-symptom {
    background: var(--color-surface);
  }
</style>
