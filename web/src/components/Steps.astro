---
import type { ServiceStep } from '../lib/types';

interface Props {
  steps: ServiceStep[];
  layout?: 'row' | 'column';
}

const { steps, layout = 'row' } = Astro.props;
---

<ol class:list={['steps', `steps-${layout}`]}>
  {
    steps.map((step, index) => (
      <li data-reveal style={`--reveal-delay: ${index * 90}ms`}>
        <span class="step-number" aria-hidden="true">
          {index + 1}
        </span>
        <div>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    gap: 1.5rem;
    list-style: none;
    counter-reset: step;
  }

  .steps-row {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }

  li {
    position: relative;
    display: grid;
    gap: 1rem;
  }

  .steps-row li {
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
  }

  .steps-column li {
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    padding-bottom: 1.5rem;
  }

  .steps-column li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 1.375rem;
    top: 3.25rem;
    bottom: 0;
    width: 2px;
    background: var(--color-line);
  }

  .step-number {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--color-dusty-light);
    color: var(--color-navy);
    font-family: var(--font-serif);
    font-variation-settings: 'SOFT' 100;
    font-size: 1.25rem;
    font-weight: 560;
  }

  .steps-row li:first-child .step-number {
    background: var(--color-accent);
    color: #fff;
  }

  h3 {
    font-size: 1.3125rem;
  }

  p {
    margin-top: 0.4rem;
    color: var(--color-text-muted);
    font-size: 1.0625rem;
  }
</style>
