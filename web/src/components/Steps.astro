---
import type { ServiceStep } from '../lib/types';

interface Props {
  steps: ServiceStep[];
  layout?: 'row' | 'column';
}

const { steps, layout = 'row' } = Astro.props;
---

<ol class:list={['steps', `steps-${layout}`]}>
  {
    steps.map((step, index) => (
      <li data-reveal style={`--reveal-delay: ${index * 90}ms`}>
        <div class="step-head">
          <span class="step-number" aria-hidden="true">
            {index + 1}
          </span>
          <h3>{step.title}</h3>
        </div>
        <p>{step.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    --number-size: 2.25rem;
    --head-gap: 0.75rem;
    display: grid;
    gap: 1rem;
    list-style: none;
  }

  .steps-row {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
  }

  li {
    position: relative;
  }

  .steps-row li {
    padding: 1.25rem 1.35rem 1.35rem;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
  }

  .steps-column {
    gap: 0;
  }

  .steps-column li {
    padding-bottom: 1.25rem;
  }

  .steps-column li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: calc(var(--number-size) / 2 - 1px);
    top: calc(var(--number-size) + 0.35rem);
    bottom: 0.35rem;
    width: 2px;
    background: var(--color-line);
  }

  .step-head {
    display: flex;
    align-items: center;
    gap: var(--head-gap);
  }

  .step-number {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: var(--number-size);
    height: var(--number-size);
    border-radius: 50%;
    background: var(--color-dusty-light);
    color: var(--color-navy);
    font-family: var(--font-serif);
    font-variation-settings: 'SOFT' 100;
    font-size: 1.0625rem;
    font-weight: 560;
  }

  .steps-row li:first-child .step-number {
    background: var(--color-action);
    color: #fff;
  }

  h3 {
    font-size: 1.25rem;
  }

  p {
    margin-top: 0.5rem;
    color: var(--color-text-muted);
    font-size: 1.0625rem;
  }

  .steps-column p {
    padding-left: calc(var(--number-size) + var(--head-gap));
  }
</style>
