---
import type { ServiceStep } from '../lib/types';

interface Props {
  steps: ServiceStep[];
  class?: string;
}

const { steps, class: className } = Astro.props;
const connector = 'M9 0C3 24 14 38 9 56S5 82 9 100';
---

<ol class:list={['steps', className]} role="list" data-ink>
  {
    steps.map((step, index) => (
      <li class="step" data-reveal style={`--reveal-delay: ${index * 75}ms`}>
        <div class="step-heading">
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
        </div>
        <p>{step.text}</p>
        {index < steps.length - 1 && (
          <svg class="step-connector ink-connector" viewBox="0 0 18 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path class="ink-rule-base" d={connector} />
            <path class="ink-stroke" pathLength="1" d={connector} />
          </svg>
        )}
      </li>
    ))
  }
</ol>

<style>
  .steps {
    --ink-rule: #d9c7b8;
    position: relative;
    z-index: 1;
    list-style: none;
  }

  .step {
    position: relative;
    padding-bottom: 26px;
  }

  .step:last-child {
    padding-bottom: 0;
  }

  .step-connector {
    position: absolute;
    top: 45px;
    bottom: 0;
    left: 13px;
    width: 18px;
    height: calc(100% - 45px);
    overflow: visible;
    color: var(--color-action);
    pointer-events: none;
  }

  .step-connector .ink-stroke {
    opacity: 0.45;
  }

  .step-heading {
    display: flex;
    align-items: flex-start;
    gap: 18px;
  }

  .step-heading > span {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid #e7d5c7;
    border-radius: 50%;
    background: var(--color-accent-soft);
    color: var(--color-navy);
    font-size: 0.9375rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  h3 {
    padding-top: 5px;
    font-family: var(--font-serif);
    font-variation-settings: 'SOFT' 100;
    font-size: 1.6875rem;
    font-weight: 480;
    letter-spacing: -0.55px;
    line-height: 1.3;
  }

  p {
    margin: 7px 0 0 62px;
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  @media (max-width: 950px) {
    .step-heading {
      gap: 14px;
    }

    h3 {
      font-size: 1.5625rem;
    }

    p {
      margin-left: 58px;
    }
  }

  @media (max-width: 640px) {
    .step {
      padding-bottom: 27px;
    }

    .step-connector {
      top: 41px;
      left: 11px;
      height: calc(100% - 41px);
    }

    .step-heading {
      gap: 14px;
    }

    .step-heading > span {
      width: 40px;
      height: 40px;
      font-size: 0.875rem;
    }

    p {
      margin: 8px 0 0 54px;
    }
  }
</style>
