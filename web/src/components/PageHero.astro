---
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  title: string;
  intro?: string;
  breadcrumbs?: { name: string; href: string }[];
  narrow?: boolean;
}

const { title, intro, breadcrumbs, narrow = false } = Astro.props;
---

<section class="page-hero">
  <div class:list={['container', { 'container-narrow': narrow }]}>
    {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
    <div class="page-hero-body">
      <h1>{title}</h1>
      {intro && <p class="lead">{intro}</p>}
      <slot />
    </div>
  </div>
  <svg class="page-hero-shape" viewBox="0 0 600 400" aria-hidden="true">
    <path
      d="M420 30c90 10 170 80 170 170s-60 170-170 180-150-40-230-50S20 300 30 200 160 60 250 40s80-20 170-10Z"
      fill="currentColor"></path>
  </svg>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(1.25rem, 1rem + 1vw, 2rem) clamp(2.25rem, 1.75rem + 2.5vw, 3.75rem);
    background: linear-gradient(180deg, var(--color-bg) 0%, var(--color-sand-soft) 100%);
    border-bottom: 1px solid var(--color-line);
  }

  .page-hero .container {
    position: relative;
    z-index: 1;
  }

  .page-hero-body {
    max-width: 50rem;
    margin-top: clamp(1.25rem, 1rem + 1.5vw, 2.25rem);
  }

  .page-hero-body > * + * {
    margin-top: 0.85rem;
  }

  .page-hero h1 {
    font-size: clamp(2.25rem, 1.7rem + 2.2vw, 3.5rem);
  }

  .page-hero .lead {
    max-width: 44rem;
  }

  .page-hero-shape {
    position: absolute;
    right: -8%;
    top: -30%;
    width: min(46rem, 70vw);
    color: var(--color-dusty-light);
    opacity: 0.55;
    pointer-events: none;
  }
</style>
