---
import Breadcrumbs from './Breadcrumbs.astro';
import InkFlourish from './ink/InkFlourish.astro';
import InkUnderline from './ink/InkUnderline.astro';

interface Props {
  title: string;
  intro?: string;
  breadcrumbs?: { name: string; href: string }[];
  narrow?: boolean;
}

const { title, intro, breadcrumbs, narrow = false } = Astro.props;
---

<section class="page-hero" data-ink>
  <div class="page-hero-ornaments" aria-hidden="true">
    <InkFlourish class="page-hero-flourish" variant="right" />
  </div>
  <div class:list={['container', { 'container-narrow': narrow }]}>
    {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
    <div class="page-hero-body">
      <h1>{title}</h1>
      <InkUnderline />
      {intro && <p class="lead">{intro}</p>}
      <slot />
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: clip;
    isolation: isolate;
    padding-block: 28px 56px;
    border-bottom: 1px solid var(--color-line);
  }

  .page-hero .container {
    position: relative;
    z-index: 1;
  }

  .page-hero-ornaments {
    position: absolute;
    z-index: 0;
    inset: 0;
    pointer-events: none;
  }

  .page-hero :global(.page-hero-flourish) {
    position: absolute;
    top: -40px;
    right: max(-60px, calc((100% - var(--container)) / 2 - 140px));
    width: 260px;
    height: 350px;
    opacity: 0.3;
  }

  .page-hero-body {
    max-width: 50rem;
    margin-top: 28px;
  }

  .page-hero h1 {
    font-size: clamp(2.625rem, 1.9rem + 2.6vw, 3.75rem);
  }

  .page-hero .lead {
    max-width: 44rem;
    margin-top: 20px;
  }

  .page-hero-body > :global(:not(h1, .ink-underline, .lead)) {
    margin-top: 12px;
  }

  @media (max-width: 950px) {
    .page-hero :global(.page-hero-flourish) {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .page-hero {
      padding-block: 20px 40px;
    }

    .page-hero-body {
      margin-top: 20px;
    }
  }
</style>
