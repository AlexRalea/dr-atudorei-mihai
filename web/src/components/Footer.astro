---
import { getConditions, getPages, getSettings } from '../lib/content';
import { isPlaceholder, telHref } from '../lib/format';
import { MEDICAL_DISCLAIMER } from '../lib/labels';
import { routes } from '../lib/routes';
import Icon from './Icon.astro';

const [settings, conditions, pages] = await Promise.all([getSettings(), getConditions(), getPages()]);
const tel = telHref(settings.phone);
const year = new Date().getFullYear();

const explore = [
  { href: routes.about, label: 'Despre medic' },
  { href: routes.services, label: 'Servicii' },
  { href: routes.conditions, label: 'Afecțiuni tratate' },
  { href: routes.articles, label: 'Articole' },
  { href: routes.faq, label: 'Întrebări frecvente' },
  { href: routes.contact, label: 'Contact și programări' },
];

const footerPages = pages.filter((page) => page.showInFooter);
const legalSlugs = ['politica-confidentialitate', 'politica-cookies'];
const infoPages = footerPages.filter((page) => !legalSlugs.includes(page.slug));
const legalPages = footerPages.filter((page) => legalSlugs.includes(page.slug));
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="footer-name">{settings.siteName}</p>
        <p class="footer-specialty">{settings.specialty}</p>
        <p class="footer-text">
          Consultații și tratament pentru afecțiunile mâinii, pumnului și degetelor, explicate pe înțeles.
        </p>
        <a href={routes.appointment} class="btn btn-light btn-sm">
          <Icon name="calendar-check" size={18} />
          Programează o consultație
        </a>
      </div>

      <nav class="footer-col" aria-label="Pagini">
        <p class="footer-title">Explorează</p>
        <ul>
          {explore.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          {infoPages.map((page) => <li><a href={routes.page(page.slug)}>{page.title}</a></li>)}
        </ul>
      </nav>

      <nav class="footer-col" aria-label="Afecțiuni">
        <p class="footer-title">Afecțiuni</p>
        <ul>
          {
            conditions.slice(0, 6).map((condition) => (
              <li>
                <a href={routes.condition(condition.slug)}>{condition.title}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="footer-col">
        <p class="footer-title">Contact</p>
        <ul class="footer-contact">
          {
            tel && (
              <li>
                <Icon name="phone" size={18} />
                <a href={tel}>{settings.phone}</a>
              </li>
            )
          }
          {
            !isPlaceholder(settings.email) && (
              <li>
                <Icon name="mail" size={18} />
                <a href={`mailto:${settings.email}`}>{settings.email}</a>
              </li>
            )
          }
          <li>
            <Icon name="map-pin" size={18} />
            <span>
              {settings.clinic.name}
              <br />
              {settings.clinic.street}, {settings.clinic.city}
            </span>
          </li>
          {
            settings.hours.map((entry) => (
              <li>
                <Icon name="clock" size={18} />
                <span>
                  {entry.days}: {entry.hours}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="footer-disclaimer">
      <Icon name="info" size={18} />
      <span>{MEDICAL_DISCLAIMER}</span>
    </p>

    <div class="footer-bottom">
      <p>
        © {year} {settings.siteName}
        {settings.cmrCode && <span> · Cod CMR {settings.cmrCode}</span>}
      </p>
      <ul>
        {legalPages.map((page) => <li><a href={routes.page(page.slug)}>{page.title}</a></li>)}
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem) 2rem;
    background: var(--color-navy);
    color: #d5dee8;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: clamp(2rem, 1rem + 3vw, 4rem);
  }

  .footer-name {
    font-family: var(--font-serif);
    font-variation-settings: 'SOFT' 100;
    font-size: 1.625rem;
    color: #fff;
  }

  .footer-specialty {
    margin-top: 0.25rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-dusty);
  }

  .footer-text {
    max-width: 32ch;
    margin: 1.25rem 0 1.75rem;
    color: #b9c7d5;
  }

  .footer-title {
    margin-bottom: 1rem;
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
  }

  .footer-col ul {
    display: grid;
    gap: 0.6rem;
    list-style: none;
  }

  .footer-col a {
    color: #c9d4df;
    transition: color 200ms var(--ease);
  }

  .footer-col a:hover {
    color: #fff;
  }

  .footer-contact li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 0.75rem;
    align-items: start;
  }

  .footer-contact :global(.icon) {
    margin-top: 0.3rem;
    color: var(--color-dusty);
  }

  .footer-disclaimer {
    display: flex;
    gap: 0.75rem;
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.05);
    font-size: var(--text-sm);
    color: #b9c7d5;
  }

  .footer-disclaimer :global(.icon) {
    flex-shrink: 0;
    margin-top: 0.15rem;
    color: var(--color-dusty);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: var(--text-sm);
    color: #9fb0c1;
  }

  .footer-bottom ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    list-style: none;
  }

  .footer-bottom a:hover {
    color: #fff;
  }

  @media (max-width: 960px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .site-footer {
      padding-bottom: 6.5rem;
    }

    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
