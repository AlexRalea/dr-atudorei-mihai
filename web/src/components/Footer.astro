---
import { getConditions, getPages, getSettings } from '../lib/content';
import { isPlaceholder, telHref } from '../lib/format';
import { MEDICAL_DISCLAIMER } from '../lib/labels';
import { routes } from '../lib/routes';
import Brand from './Brand.astro';
import Icon from './Icon.astro';

const [settings, conditions, pages] = await Promise.all([getSettings(), getConditions(), getPages()]);
const tel = telHref(settings.phone);
const year = new Date().getFullYear();

const explore = [
  { href: routes.about, label: 'Despre medic' },
  { href: routes.services, label: 'Servicii' },
  { href: routes.conditions, label: 'Afecțiuni tratate' },
  { href: routes.articles, label: 'Articole' },
  { href: routes.faq, label: 'Întrebări frecvente' },
  { href: routes.contact, label: 'Contact și programări' },
];

const footerPages = pages.filter((page) => page.showInFooter);
const legalSlugs = ['politica-confidentialitate', 'politica-cookies'];
const infoPages = footerPages.filter((page) => !legalSlugs.includes(page.slug));
const legalPages = footerPages.filter((page) => legalSlugs.includes(page.slug));
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <Brand footer />
        <p>Consultații și tratament pentru afecțiunile mâinii, pumnului și degetelor, explicate pe înțeles.</p>
        <a href={routes.appointment} class="btn btn-light btn-sm">
          <Icon name="calendar-check" size={18} />
          Programează o consultație
        </a>
      </div>

      <nav class="footer-column" aria-label="Pagini">
        <h2>Explorează</h2>
        <ul>
          {explore.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          {infoPages.map((page) => <li><a href={routes.page(page.slug)}>{page.title}</a></li>)}
        </ul>
      </nav>

      <nav class="footer-column" aria-label="Afecțiuni">
        <h2>Afecțiuni</h2>
        <ul>
          {
            conditions.slice(0, 6).map((condition) => (
              <li>
                <a href={routes.condition(condition.slug)}>{condition.title}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="footer-contact">
        <h2>Contact</h2>
        <ul>
          {
            tel && (
              <li>
                <Icon name="phone" size={18} />
                <a href={tel}>{settings.phone}</a>
              </li>
            )
          }
          {
            !isPlaceholder(settings.email) && (
              <li>
                <Icon name="mail" size={18} />
                <a href={`mailto:${settings.email}`}>{settings.email}</a>
              </li>
            )
          }
          <li>
            <Icon name="map-pin" size={19} />
            <span>
              {settings.clinic.name}
              <br />
              {settings.clinic.street}, {settings.clinic.city}
            </span>
          </li>
          {
            settings.hours.map((entry) => (
              <li>
                <Icon name="clock" size={18} />
                <span>
                  {entry.days}: {entry.hours}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="disclaimer">
      <Icon name="info" size={19} />
      <span>{MEDICAL_DISCLAIMER}</span>
    </p>

    <div class="footer-bottom">
      <p>
        © {year} {settings.siteName}
        {settings.cmrCode && <span> · Cod CMR {settings.cmrCode}</span>}
      </p>
      <ul>
        {legalPages.map((page) => <li><a href={routes.page(page.slug)}>{page.title}</a></li>)}
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding-block: 58px 22px;
    background: var(--color-navy);
    color: var(--color-dusty-light);
    font-size: 1rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.8fr 1fr 1.05fr;
    gap: 43px;
    padding-bottom: 38px;
  }

  .footer-brand > p {
    margin-block: 22px 25px;
    font-size: 1.0625rem;
  }

  h2 {
    margin-bottom: 18px;
    font-family: var(--font-sans);
    font-variation-settings: normal;
    font-weight: 550;
    font-size: 1.125rem;
    letter-spacing: 0;
    line-height: 1.35;
    color: var(--color-surface);
  }

  ul {
    list-style: none;
  }

  .footer-column li a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding-block: 7px;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-dusty-light);
  }

  .footer-column a:hover,
  .footer-contact a:hover,
  .footer-bottom a:hover {
    color: var(--color-surface);
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .footer-contact li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 17px;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .footer-contact :global(.icon) {
    margin-top: 4px;
    color: var(--color-dusty);
  }

  .disclaimer {
    display: flex;
    align-items: flex-start;
    gap: 13px;
    padding-block: 23px;
    border-block: 1px solid rgb(255 253 249 / 0.18);
    font-size: 0.875rem;
  }

  .disclaimer :global(.icon) {
    margin-top: 3px;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 9px 23px;
    padding-top: 17px;
    font-size: 0.8125rem;
  }

  .footer-bottom ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 23px;
  }

  .footer-bottom a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  @media (max-width: 1200px) {
    .footer-grid {
      gap: 27px;
    }
  }

  @media (max-width: 950px) {
    .footer-grid {
      grid-template-columns: 1.2fr 1fr;
      gap: 38px 65px;
    }
  }

  @media (max-width: 640px) {
    .site-footer {
      padding-block: 40px 107px;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-bottom: 30px;
    }

    .footer-brand > p {
      margin-block: 20px 24px;
      font-size: 1.125rem;
    }

    .footer-brand .btn {
      min-height: 50px;
      font-size: 1rem;
    }

    h2 {
      margin-bottom: 12px;
      font-size: 1.3125rem;
    }

    .footer-column li a {
      padding-block: 8px;
      font-size: 1.0625rem;
    }

    .footer-contact li {
      font-size: 1.0625rem;
    }

    .disclaimer {
      gap: 11px;
      font-size: 0.9375rem;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      padding-top: 22px;
      font-size: 0.875rem;
    }

    .footer-bottom ul {
      gap: 0 17px;
    }
  }
</style>
