---
import { icons, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
  /** Text pentru cititoarele de ecran; fără el, iconița e decorativă. */
  label?: string;
}

const { name, size = 20, strokeWidth = 1.75, class: className, label } = Astro.props;

const a11y = label ? `role="img" aria-label="${label}"` : 'aria-hidden="true" focusable="false"';

const svg = icons[name]
  .replace(/<!--[\s\S]*?-->/, '')
  .replace(/class="[^"]*"/, `class="icon${className ? ` ${className}` : ''}"`)
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace(/stroke-width="2"/, `stroke-width="${strokeWidth}"`)
  .replace('<svg', `<svg ${a11y}`);
---

<Fragment set:html={svg} />
