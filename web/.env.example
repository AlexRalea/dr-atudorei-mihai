# Domeniul final, fără slash la final. Cât timp lipsește, site-ul nu se lasă indexat.
PUBLIC_SITE_URL=

# Subfolderul în care stă site-ul (ex. /dr-atudorei-mihai pe previzualizarea de pe GitHub Pages).
# În producție rămâne gol: site-ul stă la rădăcina domeniului.
PUBLIC_BASE_PATH=

# Sanity. Cât timp lipsește PUBLIC_SANITY_PROJECT_ID, site-ul folosește conținutul din src/content/seed.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Cloudflare Turnstile (opțional, protecție anti-spam pentru formular).
PUBLIC_TURNSTILE_SITE_KEY=
